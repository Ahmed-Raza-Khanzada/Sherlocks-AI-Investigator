# Add to the portal's .env

# Where THIS SERVER reaches Sherlocks. Officers' browsers never call it: the tab goes
# through the portal's own /sherlocks/api route (SHERLOCKS_PROXY=true).
SHERLOCKS_API_BASE=http://192.168.200.239:7401/sindhpolice-sherlocks
SHERLOCKS_PROXY=true

# Same value as SHERLOCKS_AUTH_SECRET on the Sherlocks server. Given to you privately.
SHERLOCKS_SECRET=

# Token lifetime in seconds (the page renews it automatically).
SHERLOCKS_TOKEN_TTL=900
