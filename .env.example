# ---- Sherlocks ----
SHERLOCKS_ENV=development
SHERLOCKS_DATABASE_URL=postgresql://cdr_user:cdr_pass@localhost:5432/cdr_jobs
SHERLOCKS_DB_SCHEMA=sherlocks
SHERLOCKS_OUTPUT_DIR=output
# cdr_report_app (Demo data source, PDF engine) is kept in vendor/report_app - no path needed.

# API. Leave SHERLOCKS_API_KEY empty and the API is OPEN - set it in any shared deployment.
SHERLOCKS_API_HOST=127.0.0.1
SHERLOCKS_API_PORT=7401
SHERLOCKS_API_PREFIX=/sindhpolice-sherlocks
SHERLOCKS_API_KEY=
SHERLOCKS_MAX_CONCURRENT_JOBS=4

# ---- Local LLM (Ollama). No subject data leaves the network. ----
OLLAMA_BASE_URL=http://localhost:11434
SHERLOCKS_REASONING_MODEL=qwen3.5:4b
SHERLOCKS_BULK_MODEL=qwen3.5:4b
SHERLOCKS_OLLAMA_TIMEOUT=180

# ---- LLM for AI steps (address splitting, pair review, OSINT planning) ----
# openai = any OpenAI-compatible server on the LAN (vLLM / LM Studio); ollama = OLLAMA_* above.
SHERLOCKS_LLM_PROVIDER=openai
SHERLOCKS_LLM_BASE_URL=http://your-llm-host:1234/v1
SHERLOCKS_LLM_MODEL=Qwen/Qwen3.8-27B
SHERLOCKS_LLM_API_KEY=EMPTY
SHERLOCKS_LLM_TIMEOUT=60

# ---- Link graph ----
# demo = synthetic dataset (nothing leaves the machine).
# ems  = the real EMS / iCOP endpoints (reference/EMS_person_vehicle_apis.md); override
#        any endpoint/key with an EMS_* var. This is the set for live Sindh Police work.
# live = the Shield-gateway providers configured in Report_App's .env.
# In ems/live mode every person searched is ~20 queries that the upstream systems log.
SHERLOCKS_LINKGRAPH_BACKEND=demo
# EMS credentials default to reference/EMS_person_vehicle_apis.md. Override e.g.:
# EMS_CRO_KEY=...   EMS_TENANT_KEY=...   EMS_WATCHLIST_KEY=...   EMS_AVLC_BEARER=...
# Let the portal choose demo/live per run. false pins the deployment to the one above.
SHERLOCKS_LINKGRAPH_ALLOW_OVERRIDE=true
# Report_App .env holding provider URLs, keys and the Shield login. Blank = Report_App's
# own discovery (<Report_App>/.env).
SHERLOCKS_REPORT_APP_ENV=
SHERLOCKS_LINKGRAPH_MAX_DEPTH=10
SHERLOCKS_LINKGRAPH_MAX_PERSONS=100
# Provider answers are cached this long so re-opening a network does not re-query it.
SHERLOCKS_LINKGRAPH_CACHE_HOURS=24
SHERLOCKS_LINKGRAPH_PARALLEL_SYSTEMS=6

# ==== OSINT: online footprint / social media (public internet) ===================
# Every finding is stamped "unverified". A blank key = that tool is skipped, never
# faked. Prices and sign-up: reference/OSINT_APIS.md.
SHERLOCKS_OSINT_ENABLED=false
SHERLOCKS_OSINT_TOOL_TIMEOUT=120
SHERLOCKS_OSINT_DELAY=1.0
SHERLOCKS_OSINT_MAX_TOOLS=12
# Restrict to a comma-separated subset of tools (blank = the list in configs/default.yaml)
# SHERLOCKS_OSINT_ALLOWED_TOOLS=search_phone,search_username,search_social

# -- Email pivot & name matching -----------------------------------------------------
# Every email found (in a police record, or in any OSINT result) is searched online:
# accounts (holehe), breaches (HIBP), and the person behind it (Pipl, FullContact, Hunter).
# Emails those searches reveal are searched too - one level deep - up to this many per person.
SHERLOCKS_OSINT_EMAIL_PIVOTS=3
# No email anywhere: look the NAME up on Pipl (name + city, Pakistan) and Hunter (name +
# employer), and keep a result only when the records corroborate it (same phone, city,
# father as relative, employer). Needs PIPL_API_KEY and/or HUNTER_API_KEY below.
SHERLOCKS_OSINT_NAME_MATCH=true

# -- Free name search (DuckDuckGo, then Bing) - used when Bright Data is not set --------
# Sends the person's name + city to those engines. false = forbid it.
SHERLOCKS_OSINT_FREE_WEB_SEARCH=true
SHERLOCKS_OSINT_WEB_SEARCH_DELAY=3
SHERLOCKS_OSINT_WEB_SEARCH_QUERIES=3

# -- Bright Data (PAID, HIGH priority) - the real footprint finder -------------------
# brightdata.com -> API key + two zones created in the dashboard.
#   SERP zone     -> search_footprint, search_dorks_live (Google/Bing name+city dorks)
#   Unlocker zone -> scrape_url (reads a profile page to CONFIRM it is the subject)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# -- Apify (PAID, MEDIUM) - hosted scraper for Instagram/Facebook/TikTok/X -> search_apify
# apify.com -> Settings -> Integrations -> API token. Actor and its input field can be
# swapped (e.g. apify/facebook-pages-scraper with input field startUrls).
APIFY_TOKEN=
SHERLOCKS_OSINT_APIFY_ACTOR=apify/instagram-scraper
SHERLOCKS_OSINT_APIFY_INPUT_FIELD=usernames

# -- Have I Been Pwned (PAID, ~USD 4/month) - email -> breaches -> search_breach -------
HIBP_API_KEY=

# -- GitHub (FREE personal token, optional) - higher rate limit for search_github -------
GITHUB_TOKEN=

# -- IPinfo (free tier) - reserved; not used by any tool yet --------------------------
IPINFO_TOKEN=

# -- SocialCrawl (PAID, MEDIUM) - username -> profile on each platform -> search_socialcrawl
# socialcrawl.dev -> Dashboard -> API Keys. Each platform checked costs credits.
SOCIALCRAWL_API_KEY=
SHERLOCKS_OSINT_SOCIALCRAWL_PLATFORMS=instagram,facebook,tiktok,twitter,youtube,linkedin

# -- Pipl (PAID, via sales) - phone/email -> the person, their other numbers, emails,
# usernames, profiles, jobs and relatives -> search_pipl, search_pipl_email
PIPL_API_KEY=

# -- FullContact (PAID) - email/phone -> name, location, employer, social profiles
# -> search_fullcontact, search_fullcontact_phone
FULLCONTACT_API_KEY=

# -- Hunter.io (PAID, free tier 50/month) - email -> real or not, public pages it appears on
# -> search_hunter
HUNTER_API_KEY=

# -- EnformionGO / Endato (PAID) - phone -> US public records ONLY -> search_enformion
# Both from the EnformionGO dashboard: profile name (galaxy-ap-name) + password.
ENFORMION_API_PROFILE=
ENFORMION_API_KEY=

# --- Portal sign-in ---------------------------------------------------------
SHERLOCKS_AUTH_ENABLED=true
SHERLOCKS_AUTH_USERNAME=change-me
SHERLOCKS_AUTH_PASSWORD=change-me
SHERLOCKS_AUTH_SESSION_HOURS=12
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SHERLOCKS_AUTH_SECRET=

# --- Embedded in a host portal (Laravel) --------------------------------------
# The host owns accounts and saved graphs. Leave SHERLOCKS_AUTH_PASSWORD empty, set
# SHERLOCKS_AUTH_SECRET above to the SAME value as the host's SHERLOCKS_SECRET (it signs
# the tokens it gives the browser), and allow the host's origin. See docs/INTEGRATION.md.
# SHERLOCKS_CORS_ORIGINS=https://portal.example.local

# --- EMS / iCOP police systems (endpoints + keys; all required for live mode) ---
EMS_CRO_URL=
EMS_CRO_KEY=
EMS_ARMS_URL=
EMS_ARMS_API_KEY=
EMS_ARMS_SECRET_KEY=
EMS_PSRMS_URL=
EMS_PSRMS_KEY=
EMS_PSRMS_CHECK_URL=
EMS_CFMS_URL=
EMS_WATCHLIST_URL=
EMS_WATCHLIST_KEY=
EMS_HOTEL_CNIC_URL=
EMS_HOTEL_MOBILE_URL=
EMS_HOTEL_KEY=
EMS_SBVS_BASE=
EMS_SBVS_KEY=
EMS_PRVS_BASE=
EMS_PRVS_KEY=
EMS_EVS_URL=
EMS_HOPE_EMP_URL=
EMS_HOPE_EMPR_URL=
EMS_WTOWER_I_KEY=
EMS_WTOWER_J_KEY=
EMS_WTOWER_API_TOKEN=
EMS_DLS_LOGIN_URL=
EMS_DLS_API=
EMS_DLS_USER=
EMS_DLS_PASS=
EMS_IGP_URL=
EMS_IGP_KEY=
EMS_PFC_URL=
EMS_PFC_KEY=
EMS_HRMIS_URL=
EMS_HRMIS_KEY=
EMS_HRMIS_BASIC=
EMS_TENANT_BASE=
EMS_TENANT_KEY=
EMS_MILAP_URL=
EMS_MILAP_KEY=
EMS_SUBSCRIBER_URL=
EMS_SUBSCRIBER_APPKEY=
EMS_NADRA_URL=
EMS_NADRA_AUTOKENN=
EMS_NADRA_SECRT=
EMS_NADRA_REQUESTER=
EMS_EXCISE_URL=
EMS_EXCISE_BASIC=
EMS_TRACS_URL=
EMS_TRACS_BASIC=
EMS_AVLC_URL=
EMS_AVLC_KEY=
EMS_AVLC_BEARER=

# --- Case evidence: FIR files, forensic lab reports, CRO dossiers ---------------
# Read while the graph builds; the chat (Sherlock) and the case report cite them.
# FIR file report (PSRMS Criminal_api/firfilereport) - uses EMS_PSRMS_KEY.
EMS_PSRMS_FIR_URL=
# Optional session cookie some PSRMS builds want on the FIR report.
EMS_PSRMS_FIR_COOKIE=
# Labs show-reports (DNA / chemical / FSL / medico-legal per FIR) - header api-token.
EMS_LABS_URL=
EMS_LABS_TOKEN=
# SAFE CRO dossier PDF per CRO number - header x-api-key.
EMS_SAFE_CRO_URL=
EMS_SAFE_KEY=
SHERLOCKS_EVIDENCE_ENABLED=true
# Each document is one upstream query; this caps them per graph.
SHERLOCKS_EVIDENCE_MAX_DOCUMENTS=40
SHERLOCKS_EVIDENCE_LAB_REPORTS=true
SHERLOCKS_EVIDENCE_CRO_DOSSIERS=true
# Scanned pages are read by the vision model (SHERLOCKS_LLM_VISION) - no OCR engine.
SHERLOCKS_EVIDENCE_OCR=true
# The AI reader turns narratives / case diaries / report text into quoted facts.
SHERLOCKS_EVIDENCE_AI_READER=true
# Write the case report as soon as the graph finishes or is stopped.
SHERLOCKS_EVIDENCE_AUTO_REPORT=true
# Live police-system calls the chat may make per question (fetch a document, one lookup).
SHERLOCKS_EVIDENCE_CHAT_LIVE_CALLS=4
# The LLM is a vision-language model (Qwen 27B on the LAN): it reads scanned pages,
# Urdu and English. false = scanned pages are listed as unread.
SHERLOCKS_LLM_VISION=true

# TRUST comprehensive-info is slow (~40s); longer per-request timeout for it.
EMS_TRUST_TIMEOUT=75

# Slow endpoints (TRUST ~40s, Hotel Eye by-mobile ~90s) get this longer timeout.
EMS_SLOW_TIMEOUT=120
